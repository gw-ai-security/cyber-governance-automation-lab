# =============================================================
# .gitignore — cyber-governance-automation-lab
# Python / VS Code / Windows / Power Automate / Power BI project
# =============================================================

# -------------------------------------------------------------
# 1. Python
# -------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# Testing / coverage / type-checker caches
.pytest_cache/
.cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.tox/
.nox/

# Build / distribution artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# -------------------------------------------------------------
# 2. Secrets & Environment files
# -------------------------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
*credentials*.json
*secrets*.json
.secrets/

# -------------------------------------------------------------
# 3. VS Code / IDE (conservative)
# -------------------------------------------------------------
# Only ignore user-/machine-local VS Code state, keep shared
# workspace configuration versionable on purpose.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.history/
*.code-workspace
.idea/

# -------------------------------------------------------------
# 4. Windows
# -------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# -------------------------------------------------------------
# 5. Logs & temporary files
# -------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
~$*
.tmp/

# -------------------------------------------------------------
# 6. Power BI (only clearly local/user-specific artifacts)
# -------------------------------------------------------------
*.pbi.bak
**/.pbi/localSettings.json
**/.pbi/cache.abf
~*.pbix
*.pbix.lock

# -------------------------------------------------------------
# 7. Generated curated runtime outputs
# -------------------------------------------------------------
data/curated/*
!data/curated/.gitkeep

# -------------------------------------------------------------
# 8. Operational Microsoft 365 workbook (Phases 5–7)
# -------------------------------------------------------------
# The live workbook can contain authenticated responder identity
# and reachable acceptance-test recipients. It is an operational
# PoC artifact, not a canonical repository dataset.
Cyber_Governance_Control_Register.xlsx

# -------------------------------------------------------------
# 9. Private Power Automate deployment/runtime artifacts
# -------------------------------------------------------------
power_automate/exports/
power_automate/private/
power_automate/snapshots/

# -------------------------------------------------------------
# 10. Project-specific keep-list / do NOT ignore
# -------------------------------------------------------------
# Canonical source/reference data, public documentation/evidence,
# source-controlled AI/API/Power Platform/Power BI definitions,
# requirements, Python source, and tests remain versionable.
# data/curated is the exception above: generated outputs remain
# ignored while the placeholder keeps the directory in Git.
!data/raw/
!data/reference/
!docs/
!ai/prompts/
!ai/schemas/
!ai/examples/
!api/
!power_automate/solutions/
!powerbi/
!requirements.txt
!src/
!tests/
