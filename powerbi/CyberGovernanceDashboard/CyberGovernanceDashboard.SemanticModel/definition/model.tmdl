model Model
	culture: de-DE
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: de-DE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DataRoot","ControlStatus","DataQualityIssues"]

ref table ControlStatus
ref table DataQualityIssues

ref cultureInfo de-DE

